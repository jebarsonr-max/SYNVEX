# SYNVEX Environment Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME=SYNVEX
SECRET_KEY=synvex-super-secure-production-ready-jwt-secret-key-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (defaults to SQLite if PostgreSQL not provided)
DATABASE_URL=sqlite:///./synvex.db

# Storage & Upload limits
MAX_UPLOAD_SIZE_MB=25
TEMP_UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Optional AI / Threat APIs
GROQ_API_KEY=
